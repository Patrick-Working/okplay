+/* OKP_PREVIEW_BOXES=1: show the boxes even where tests would answer them (to look at the design) */
+static BOOL test_answers( void )
+{
+    const char *p = getenv( "OKP_PREVIEW_BOXES" );
+    return !(p && *p == '1');
+}
