-    if ( ERROR_SUCCESS == RegGetValueW( key, NULL, name, RRF_RT_DWORD, NULL, value, &size ) )
-        return TRUE;
-
-    buffer = malloc( size );
-    if ( !buffer )
-        return FALSE;
-
-    if ( ERROR_SUCCESS != RegGetValueW( key, NULL, name, RRF_RT_REG_SZ, NULL, buffer, &size ) )
-    {
