+  GUID instance;
+  BOOL found;
+};
+
+static BOOL CALLBACK DPL_FindSessionCb( const DPSESSIONDESC2 *desc, DWORD *timeout, DWORD flags, void *ctx )
+{
+  struct find_session *f = ctx;
+  if( flags & DPESC_TIMEDOUT ) return FALSE;
+  TRACE( "session %s (instance %s) - looking for %s\n", desc ? debugstr_w( desc->lpszSessionName ) : "-",
+         desc ? debugstr_guid( &desc->guidInstance ) : "-", debugstr_w( f->name ) );
+  if( desc && desc->lpszSessionName && !wcscmp( desc->lpszSessionName, f->name ) )
+  {
+    f->instance = desc->guidInstance;
+    f->found = TRUE;
+    return FALSE;
+  }
+  return TRUE;
+}
+
+static HRESULT DPL_FindSessionByName( IDirectPlay4 *dp, DPSESSIONDESC2 *want )
+{
+  struct find_session f;
+  DPSESSIONDESC2 desc;
+  int tries;
+
+  if( !want->lpszSessionName ) return DPERR_NOSESSIONS;
+  f.name = want->lpszSessionName;
+  f.found = FALSE;
+  memset( &desc, 0, sizeof(desc) );
+  desc.dwSize = sizeof(desc);
+  desc.guidApplication = want->guidApplication;
+  for( tries = 0; tries < 10 && !f.found; tries++ )
+    IDirectPlayX_EnumSessions( dp, &desc, 2000, DPL_FindSessionCb, &f, DPENUMSESSIONS_AVAILABLE );
+  if( !f.found ) return DPERR_NOSESSIONS;
+  want->guidInstance = f.instance;
+  return DP_OK;
+}
