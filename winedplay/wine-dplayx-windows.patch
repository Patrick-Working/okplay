+static void brand_w( WCHAR *out, DWORD size )
+{
+    char b[ 96 ];
+    ini_str( "brand", "Classic Netplay", b, sizeof(b) );
+    MultiByteToWideChar( CP_ACP, 0, b, -1, out, size );
+}
