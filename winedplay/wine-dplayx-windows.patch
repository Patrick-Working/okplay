-
-  This->dp2->bDPLSPInitialized = TRUE;
-
-  /* This interface is now initialized as a lobby object */
-  This->dp2->connectionInitialized = DP_LOBBY_PROVIDER;
-
-  /* Store the handle of the module so that we can unload it later */
