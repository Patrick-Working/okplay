+void DP_BUILTIN_AddConnections( struct list *connections )
+{
+    char online[ 128 ], lan[ 128 ];
+    ini_str( "online_name", "Classic Netplay Online", online, sizeof(online) );
+    ini_str( "lan_name", "Classic Netplay LAN", lan, sizeof(lan) );
