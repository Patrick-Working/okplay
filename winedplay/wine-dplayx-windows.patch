-  /* Remove all links to groups that this group has since this is dp3 */
-  IDirectPlayX_EnumGroupsInGroup( &This->IDirectPlay4_iface, idGroup, NULL, cbRemoveGroupOrPlayer,
-          (void*)&context, 0 );
