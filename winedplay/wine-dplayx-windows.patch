+static int test_lobby_qn;
+static LONG test_lobby_lock;   /* a spin lock: needs no initialisation (fine on Windows 98) */
+static void test_lobby_enter( void ) { while( InterlockedExchange( &test_lobby_lock, 1 ) ) Sleep( 0 ); }
+static void test_lobby_leave( void ) { InterlockedExchange( &test_lobby_lock, 0 ); }
+
+static void test_lobby_queue( const void *msg, DWORD size, DWORD flags )
+{
+  test_lobby_enter();
+  if( test_lobby_qn < ARRAY_SIZE( test_lobby_q ) && size <= sizeof(test_lobby_q[ 0 ].data) )
