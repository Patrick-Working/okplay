-HRESULT DP_HandleGameMessage( IDirectPlayImpl *This, void *messageBody, DWORD messageBodySize,
-                              DPID fromId, DPID toId )
-{
-  DPMSG_GENERIC *msg;
-  DWORD msgSize;
-  HRESULT hr;
-
-  TRACE( "(%p)->(%p,0x%08lx,0x%08lx,0x%08lx)\n", This, messageBody, messageBodySize, fromId, toId );
