+static HRESULT DPWS_GetConnection( DPWS_DATA *dpwsData, SOCKADDR_IN *addr, BOOL guaranteed,
+                                   DPWS_OUT_CONNECTION **connection );
+static BOOL DPWS_SameRouter( SOCKADDR_IN *addr, BOOL tcp );
