+    InitializeCriticalSection( &obj->lock );
     DPQ_INIT( obj->msgs );
 
     hr = IDirectPlayLobby_QueryInterface( &obj->IDirectPlayLobby3_iface, riid, ppv );
diff -ruN src/dlls/dplayx/groups.c port/dlls/dplayx/groups.c
--- src/dlls/dplayx/groups.c	1969-12-31 17:00:00.000000000 -0700
+++ port/dlls/dplayx/groups.c	2026-11-09 23:21:56.500923400 -0700
@@ -0,0 +1,283 @@
+/*
+ * Groups between machines.
+ *
+ * Wine's dplayx kept groups on the machine that made them: no other machine heard of a group, its
+ * players, its name or data, and a joiner numbered its groups itself (ids that could clash with the
+ * host's). Windows sends every change to every machine (S3 wire tap, dptest --groups, 2026-10-28):
+ *
+ *   CreateGroup / CreateGroupInGroup  a joiner first asks the host for an id (REQUESTGROUPID 6,
+ *                     12 bytes, the creation flags; the host answers REQUESTPLAYERREPLY 7), then
+ *                     CREATEGROUP 9: CREATEPLAYER's layout, the packed group with flags 0x48
+ *                     (DPLAYI_GROUP_DPLAYOWNS | DPLAYI_PLAYER_PLAYERLOCAL), the creating machine's
+ *                     system player, the parent for a group in a group, 6 reserved bytes at the end
+ *   AddPlayerToGroup / DeletePlayerFromGroup   ADDPLAYERTOGROUP 13 / DELETEPLAYERFROMGROUP 14
+ *   DestroyGroup      DELETEPLAYERFROMGROUP for each player in it, then DELETEGROUP 12
+ *   AddGroupToGroup / DeleteGroupFromGroup     ADDSHORTCUTTOGROUP 39 / DELETEGROUPFROMGROUP 40,
+ *                     the group in the player field and the parent in the group field
+ *   SetGroupName / SetGroupData (remote)       GROUPNAMECHANGED 18 / GROUPDATACHANGED 17
+ *
+ * The fixed ones are 28 bytes: envelope, to (0), player, group, two offsets (0). Receivers apply the
+ * change through the same code a local call uses, with This->dp2->groupFromWire set so nothing is
+ * sent on again, and their players get the same system messages as for a local change.
+ *
+ * Part of the Windows port for Classic Netplay for AoE2. LGPL 2.1+, like the rest of dplayx.
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winerror.h"
+#include "wine/debug.h"
+
+#include "dplay_global.h"
+#include "dplayx_global.h"
+#include "dplayx_messages.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dplay);
+
+#define GROUP_PACKED_FLAGS  ( DPLAYI_GROUP_DPLAYOWNS | DPLAYI_PLAYER_PLAYERLOCAL )   /* 0x48, Windows */
+#define GROUP_STAGING_BIT   0x00000200   /* DPLAYI_GROUP_STAGINGAREA [UNV on the wire: only plain groups captured] */
+
+/* may a group change go out now? (a session with other machines, and not a change that came in) */
+static BOOL grp_may_send( IDirectPlayImpl *This )
+{
+    return This->dp2->bConnectionOpen && This->dp2->lpSysGroup && !This->dp2->groupFromWire;
+}
+
+static void grp_envelope( DPMSG_SENDENVELOPE *e, WORD cmd )
+{
+    e->dwMagic = DPMSGMAGIC_DPLAYMSG;
+    e->wCommandId = cmd;
+    e->wVersion = DPMSGVER_DP6;
+}
+
+/* the 28-byte ones: DELETEGROUP, ADD/DELETEPLAYERTOGROUP, ADDSHORTCUTTOGROUP, DELETEGROUPFROMGROUP */
+void DP_GRP_SendIds( IDirectPlayImpl *This, WORD cmd, DPID player, DPID group )
+{
+    DPSP_MSG_DELETEPLAYER msg = { 0 };   /* the same layout */
+
+    EnterCriticalSection( &This->lock );
+    if ( grp_may_send( This ) )
+    {
+        grp_envelope( &msg.envelope, cmd );
+        msg.playerId = player;
+        msg.groupId = group;
+        TRACE( "group message %u: player 0x%08lx group 0x%08lx\n", cmd, player, group );
+        DP_SendToAllMachines( This, &msg, sizeof(msg), NULL, 0 );
+    }
+    LeaveCriticalSection( &This->lock );
+}
+
+static DWORD grp_wstr_size( const WCHAR *s )
+{
+    return s ? ( lstrlenW( s ) + 1 ) * sizeof(WCHAR) : 0;
+}
+
+void DP_GRP_SendCreate( IDirectPlayImpl *This, DPID id, DPID parent, DWORD flags, const DPNAME *name,
+                        const void *data, DWORD dataSize )
+{
+    DPMSG_CREATESESSION *msg;   /* CREATEPLAYER's header (Wine's name for command 8) */
+    DPLAYI_PACKEDPLAYER *packed;
+    DWORD ns, ls, size;
+    BYTE *p;
+
+    EnterCriticalSection( &This->lock );
+    if ( !grp_may_send( This ) )
+    {
+        LeaveCriticalSection( &This->lock );
+        return;
+    }
+    ns = name ? grp_wstr_size( name->lpszShortName ) : 0;
+    ls = name ? grp_wstr_size( name->lpszLongName ) : 0;
+    size = sizeof(*msg) + sizeof(*packed) + ns + ls + dataSize + 6;
+    if ( !(p = calloc( 1, size )) )
+    {
+        LeaveCriticalSection( &This->lock );
+        return;
+    }
+    msg = (DPMSG_CREATESESSION *)p;
+    grp_envelope( &msg->envelope, DPMSGCMD_CREATEGROUP );
+    msg->playerId = id;
+    msg->createOffset = sizeof(*msg);
+    packed = (DPLAYI_PACKEDPLAYER *)(msg + 1);
+    packed->size = sizeof(*packed) + ns + ls + dataSize;
+    packed->flags = GROUP_PACKED_FLAGS | ((flags & DPGROUP_HIDDEN) ? DPLAYI_GROUP_HIDDEN : 0) |
+                    ((flags & DPGROUP_STAGINGAREA) ? GROUP_STAGING_BIT : 0);
+    packed->id = id;
+    packed->shortNameLength = ns;
+    packed->longNameLength = ls;
+    packed->playerDataLength = dataSize;
+    packed->systemPlayerId = This->dp2->systemPlayerId;
+    packed->fixedSize = sizeof(*packed);
+    packed->version = DPMSGVER_DP6;
+    packed->parentId = parent == DPID_NOPARENT_GROUP ? 0 : parent;
+    p = (BYTE *)(packed + 1);
+    if ( ns ) memcpy( p, name->lpszShortName, ns );
+    p += ns;
+    if ( ls ) memcpy( p, name->lpszLongName, ls );
+    p += ls;
+    if ( dataSize ) memcpy( p, data, dataSize );
+    TRACE( "CREATEGROUP 0x%08lx parent 0x%08lx, %lu bytes\n", id, parent, size );
+    DP_SendToAllMachines( This, msg, size, NULL, 0 );
+    free( msg );
+    LeaveCriticalSection( &This->lock );
+}
+
+void DP_GRP_SendName( IDirectPlayImpl *This, DPID id, const DPNAME *name )
+{
+    DPSP_MSG_GROUPNAMECHANGED *msg;
+    DWORD ns, ls, size;
+
+    EnterCriticalSection( &This->lock );
+    if ( !grp_may_send( This ) )
+    {
+        LeaveCriticalSection( &This->lock );
+        return;
+    }
+    ns = name ? grp_wstr_size( name->lpszShortName ) : 0;
+    ls = name ? grp_wstr_size( name->lpszLongName ) : 0;
+    size = sizeof(*msg) + ns + ls;
+    if ( (msg = calloc( 1, size )) )
+    {
+        grp_envelope( &msg->envelope, DPMSGCMD_GROUPNAMECHANGED );
+        msg->groupId = id;
+        msg->shortNameOffset = ns ? sizeof(*msg) : 0;
+        msg->longNameOffset = ls ? sizeof(*msg) + ns : 0;
+        if ( ns ) memcpy( (BYTE *)(msg + 1), name->lpszShortName, ns );
+        if ( ls ) memcpy( (BYTE *)(msg + 1) + ns, name->lpszLongName, ls );
+        DP_SendToAllMachines( This, msg, size, NULL, 0 );
+        free( msg );
+    }
+    LeaveCriticalSection( &This->lock );
+}
+
+void DP_GRP_SendData( IDirectPlayImpl *This, DPID id, const void *data, DWORD dataSize )
+{
+    DPSP_MSG_GROUPDATACHANGED *msg;
+    DWORD size;
+
+    EnterCriticalSection( &This->lock );
+    if ( !grp_may_send( This ) )
+    {
+        LeaveCriticalSection( &This->lock );
+        return;
+    }
+    size = sizeof(*msg) + dataSize;
+    if ( (msg = calloc( 1, size )) )
+    {
+        grp_envelope( &msg->envelope, DPMSGCMD_GROUPDATACHANGED );
+        msg->groupId = id;
+        msg->dataSize = dataSize;
+        msg->dataOffset = sizeof(*msg);
+        if ( dataSize ) memcpy( msg + 1, data, dataSize );
+        DP_SendToAllMachines( This, msg, size, NULL, 0 );
+        free( msg );
+    }
+    LeaveCriticalSection( &This->lock );
+}
+
+/* ---- receiving */
+
+HRESULT DP_GRP_HandleCreate( IDirectPlayImpl *This, const void *body, DWORD size, void *header )
+{
+    const DPMSG_CREATESESSION *msg = body;
+    DPPLAYERINFO info;
+    DWORD offset = sizeof(*msg), flags = 0;
+    DPID id, parent;
+    HRESULT hr;
+
+    if ( size < sizeof(*msg) )
+        return DPERR_GENERIC;
+    memset( &info, 0, sizeof(info) );
+    hr = DP_MSG_ReadPackedPlayer( (char *)body, &offset, size, &info );
+    if ( FAILED( hr ) )
+        return hr;
+    /* a machine announces its own groups only (naming no machine: the sender's) */
+    if ( !info.systemPlayerId )
+    {
+        BOOL known;
+        EnterCriticalSection( &This->lock );
+        info.systemPlayerId = DP_SenderMachine( This, header, &known );
+        LeaveCriticalSection( &This->lock );
+        if ( known && !info.systemPlayerId )
+            DP_NOTE( "CREATEGROUP 0x%08lx names no machine and comes from one we do not know - taken\n", msg->playerId );
+    }
+    if ( info.systemPlayerId && !DP_SenderOwns( This, header, info.systemPlayerId, "CREATEGROUP" ) )
+        return DP_OK;
+    if ( !msg->playerId )
+        return DP_OK;
+    if ( info.flags & DPLAYI_GROUP_HIDDEN ) flags |= DPGROUP_HIDDEN;
+    if ( info.flags & GROUP_STAGING_BIT ) flags |= DPGROUP_STAGINGAREA;
+    id = msg->playerId;
+    parent = info.parentId ? info.parentId : DPID_NOPARENT_GROUP;
+
+    EnterCriticalSection( &This->lock );
+    if ( This->dp2->bConnectionOpen && !DP_FindAnyGroup( This, id ) )
+    {
+        hr = DP_CreateGroup( This, header, &id, &info.name, info.playerData, info.playerDataLength,
+                             flags, parent, FALSE );
+        if ( SUCCEEDED( hr ) )
+            DP_QueueGroupCreatedFromWire( This, id, info.playerData, info.playerDataLength, flags, parent );
+        else
+            WARN( "CREATEGROUP 0x%08lx (parent 0x%08lx): 0x%08lx\n", id, parent, hr );
+    }
+    LeaveCriticalSection( &This->lock );
+    return DP_OK;
+}
+
+HRESULT DP_GRP_HandleIds( IDirectPlayImpl *This, WORD cmd, const void *body, DWORD size, void *header )
+{
+    const DPSP_MSG_DELETEPLAYER *msg = body;
+    IDirectPlay4 *dp = &This->IDirectPlay4_iface;
+    HRESULT hr = DP_OK;
+
+    if ( size < sizeof(*msg) )
+        return DPERR_GENERIC;
+
+    EnterCriticalSection( &This->lock );
+    if ( !This->dp2->bConnectionOpen )
+    {
+        LeaveCriticalSection( &This->lock );
+        return DP_OK;
+    }
+    This->dp2->groupFromWire++;
+    switch ( cmd )
+    {
+    case DPMSGCMD_ADDPLAYERTOGROUP:     hr = DP_AddPlayerToGroup( This, msg->groupId, msg->playerId ); break;
+    case DPMSGCMD_DELETEPLAYERFROMGROUP: hr = IDirectPlayX_DeletePlayerFromGroup( dp, msg->groupId, msg->playerId ); break;
+    case DPMSGCMD_DELETEGROUP:          hr = IDirectPlayX_DestroyGroup( dp, msg->groupId ); break;
+    case DPMSGCMD_ADDSHORTCUTTOGROUP:   hr = IDirectPlayX_AddGroupToGroup( dp, msg->groupId, msg->playerId ); break;
+    case DPMSGCMD_DELETEGROUPFROMGROUP: hr = IDirectPlayX_DeleteGroupFromGroup( dp, msg->groupId, msg->playerId ); break;
+    }
+    This->dp2->groupFromWire--;
+    LeaveCriticalSection( &This->lock );
+    if ( FAILED( hr ) )
+        TRACE( "group message %u (player 0x%08lx, group 0x%08lx): 0x%08lx\n", cmd, msg->playerId, msg->groupId, hr );
+    return DP_OK;
+}
+
+HRESULT DP_GRP_HandleName( IDirectPlayImpl *This, const void *body, DWORD size, void *header )
+{
+    const DPSP_MSG_GROUPNAMECHANGED *msg = body;
+    DPNAME name;
+
+    if ( size < sizeof(*msg) )
+        return DPERR_GENERIC;
+    memset( &name, 0, sizeof(name) );
+    name.dwSize = sizeof(name);
+    name.lpszShortName = (WCHAR *)DP_WireString( body, size, msg->shortNameOffset );
+    name.lpszLongName = (WCHAR *)DP_WireString( body, size, msg->longNameOffset );
+
+    EnterCriticalSection( &This->lock );
+    if ( This->dp2->bConnectionOpen )
+    {
+        This->dp2->groupFromWire++;
+        IDirectPlayX_SetGroupName( &This->IDirectPlay4_iface, msg->groupId, &name, 0 );
+        This->dp2->groupFromWire--;
+    }
+    LeaveCriticalSection( &This->lock );
+    return DP_OK;
+}
diff -ruN src/dlls/dplayx/host.c port/dlls/dplayx/host.c
--- src/dlls/dplayx/host.c	1969-12-31 17:00:00.000000000 -0700
+++ port/dlls/dplayx/host.c	2026-11-10 11:07:11.040466200 -0700
@@ -0,0 +1,353 @@
+/*
+ * Hosting: letting other machines join a session this dplayx created.
+ *
+ * Wine's dplayx could join a session hosted by Windows, but as a host it only answered session
+ * enumeration and player-id requests; the join itself (FORWARDADDPLAYER) was a stub. This adds
+ * the host side of the join, in the message formats Windows uses (as captured in Wine's own
+ * conformance tests, dlls/dplayx/tests/dplayx.c):
+ *
+ *   joiner -> host   FORWARDADDPLAYER (19): the joiner's system player, packed, + password
+ *   host  -> others  ADDFORWARD (46): the same player, so every machine knows the newcomer
+ *   host  -> joiner  SUPERENUMPLAYERSREPLY (41): session description, name and every player and
+ *                    group ("super packed"), or FORWARDADDPLAYERNACK (36) with an error
+ *
+ * Part of the Windows port for Classic Netplay for AoE2. LGPL 2.1+, like the rest of dplayx.
+ */
+
+#include <stdarg.h>
+#include <string.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winerror.h"
+#include "wine/debug.h"
+
+#include <wchar.h>
+#include "dplay_global.h"
+#include "dplayx_global.h"
+#include "dplayx_messages.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dplay);
+
+/* the player/protocol version Windows (DirectX 7+) puts in these messages */
+#define HOST_WIRE_VERSION 14
+
+/* growable reply buffer */
+struct buf
+{
+    char *data;
+    DWORD size, cap;
+    BOOL failed;
+};
+
+static void *buf_add( struct buf *b, const void *src, DWORD len )
+{
+    char *p;
+    if ( b->failed ) return NULL;
+    if ( b->size + len > b->cap )
+    {
+        DWORD cap = max( b->cap * 2, b->size + len + 256 );
+        char *n = realloc( b->data, cap );
+        if ( !n ) { b->failed = TRUE; return NULL; }
+        b->data = n;
+        b->cap = cap;
+    }
+    p = b->data + b->size;
+    if ( src ) memcpy( p, src, len );
+    else memset( p, 0, len );
+    b->size += len;
+    return p;
+}
+
+/* smallest size code (1: BYTE, 2: WORD, 3: DWORD; 0: value is 0 and not sent) */
+static DWORD size_code( DWORD value )
+{
+    return !value ? 0 : value <= 0xff ? 1 : value <= 0xffff ? 2 : 3;
+}
+
+static void add_int( struct buf *b, DWORD code, DWORD value )
+{
+    BYTE b1 = (BYTE)value;
+    WORD w = (WORD)value;
+    if ( code == 1 ) buf_add( b, &b1, 1 );
+    else if ( code == 2 ) buf_add( b, &w, 2 );
+    else if ( code == 3 ) buf_add( b, &value, 4 );
+}
+
+static void add_wstr( struct buf *b, const WCHAR *s )
+{
+    buf_add( b, s, (lstrlenW( s ) + 1) * sizeof(WCHAR) );
+}
+
+/* one DPLAYI_SUPERPACKEDPLAYER entry, as Windows sends it */
+static void add_super_packed( IDirectPlayImpl *This, struct buf *b, DPID id, DWORD flags,
+                              const DPNAME *name, const void *data, DWORD dataSize,
+                              DPID systemPlayerId, const DPID *members, DWORD memberCount,
+                              DPID parentId, BOOL group )
+{
+    DPLAYI_SUPERPACKEDPLAYER sp;
+    void *spData = NULL;
+    DWORD spDataSize = 0, mask = 0;
+    BOOL shortName = name && name->lpszShortName && name->lpszShortName[ 0 ];
+    BOOL longName = name && name->lpszLongName && name->lpszLongName[ 0 ];
+
+    if ( !group )
+        IDirectPlaySP_GetSPPlayerData( This->dp2->spData.lpISP, id, &spData, &spDataSize, DPSET_REMOTE );
+
+    if ( shortName ) mask |= DPLAYI_SUPERPACKEDPLAYER_SHORT_NAME_PRESENT;
+    if ( longName ) mask |= DPLAYI_SUPERPACKEDPLAYER_LONG_NAME_PRESENT;
+    mask |= size_code( spDataSize ) << 2;
+    mask |= size_code( dataSize ) << 4;
+    mask |= size_code( memberCount ) << 6;
+    if ( parentId ) mask |= DPLAYI_SUPERPACKEDPLAYER_PARENT_ID_PRESENT;
+
+    sp.size = 16;
+    sp.flags = flags;
+    sp.id = id;
+    sp.infoMask = mask;
+    sp.versionOrSystemPlayerId = ( flags & DPLAYI_PLAYER_SYSPLAYER ) ? HOST_WIRE_VERSION : systemPlayerId;
+    buf_add( b, &sp, sizeof(sp) );
+    if ( shortName ) add_wstr( b, name->lpszShortName );
+    if ( longName ) add_wstr( b, name->lpszLongName );
+    add_int( b, size_code( dataSize ), dataSize );
+    if ( dataSize ) buf_add( b, data, dataSize );
+    add_int( b, size_code( spDataSize ), spDataSize );
+    if ( spDataSize ) buf_add( b, spData, spDataSize );
+    add_int( b, size_code( memberCount ), memberCount );
+    if ( memberCount ) buf_add( b, members, memberCount * sizeof(DPID) );
+    if ( parentId ) buf_add( b, &parentId, sizeof(DPID) );
+}
+
+static HRESULT nack( IDirectPlayImpl *This, HRESULT error, void **reply, DWORD *replySize )
+{
+    DWORD header = This->dp2->spData.dwSPHeaderSize;
+    DPSP_MSG_ADDFORWARDREPLY *msg;
+
+    WARN( "refusing the join: %s\n", DPLAYX_HresultToString( error ) );
+    *replySize = header + sizeof(*msg);
+    if ( !(*reply = calloc( 1, *replySize )) )
+        return DPERR_OUTOFMEMORY;
+    msg = (DPSP_MSG_ADDFORWARDREPLY *)((char *)*reply + header);
+    msg->envelope.dwMagic = DPMSGMAGIC_DPLAYMSG;
+    msg->envelope.wCommandId = DPMSGCMD_FORWARDADDPLAYERNACK;
+    msg->envelope.wVersion = HOST_WIRE_VERSION;
+    msg->error = error;
+    return DP_OK;
+}
+
+/* tell one other machine about the newcomer (it answers with ADDFORWARDACK) */
+static void send_add_forward( IDirectPlayImpl *This, DPID to, const DPMSG_FORWARDADDPLAYER *request,
+                              const void *packed, DWORD packedSize )
+{
+    DPSP_MSG_ADDFORWARD msg;
+    SGBUFFER buffers[ 3 ] = { 0 };
+    DPSP_SENDEXDATA data = { 0 };
+    HRESULT hr;
+
+    msg.envelope.dwMagic = DPMSGMAGIC_DPLAYMSG;
+    msg.envelope.wCommandId = DPMSGCMD_ADDFORWARD;
+    msg.envelope.wVersion = HOST_WIRE_VERSION;
+    msg.toId = 0;
+    msg.playerId = request->playerId;
+    msg.groupId = 0;
+    msg.createOffset = sizeof(msg);
+    msg.passwordOffset = 0;
+
+    buffers[ 0 ].len = This->dp2->spData.dwSPHeaderSize;
+    buffers[ 1 ].len = sizeof(msg);
+    buffers[ 1 ].pData = (UCHAR *)&msg;
+    buffers[ 2 ].len = packedSize;
+    buffers[ 2 ].pData = (UCHAR *)packed;
+
+    data.lpISP = This->dp2->spData.lpISP;
+    data.dwFlags = DPSEND_GUARANTEED;
+    data.idPlayerTo = to;
+    data.idPlayerFrom = This->dp2->systemPlayerId;
+    data.lpSendBuffers = buffers;
+    data.cBuffers = ARRAYSIZE( buffers );
+    data.dwMessageSize = DP_MSG_ComputeMessageSize( buffers, ARRAYSIZE( buffers ) );
+    data.bSystemMessage = TRUE;
+    hr = DP_SP_SendEx( This, &data );
+    TRACE( "ADDFORWARD 0x%08lx -> machine 0x%08lx: %s\n", request->playerId, to, DPLAYX_HresultToString( hr ) );
+}
+
+HRESULT DP_HOST_HandleForwardAddPlayer( IDirectPlayImpl *This, void *body, DWORD bodySize,
+                                        void *header, void **reply, DWORD *replySize )
+{
+    const DPMSG_FORWARDADDPLAYER *request = body;
+    DPSP_MSG_SUPERENUMPLAYERSREPLY *out;
+    DPSESSIONDESC2 *sd, sdCopy;
+    struct PlayerList *plist;
+    struct GroupList *glist;
+    struct buf b = { 0 };
+    DPPLAYERINFO info;
+    const WCHAR *password = NULL;
+    DWORD offset, packedStart, headerSize = This->dp2->spData.dwSPHeaderSize;
+    DWORD players = 0, groups = 0;
+    HRESULT hr;
+
+    if ( bodySize < sizeof(*request) || request->createOffset < sizeof(*request) || request->createOffset > bodySize )
+        return DPERR_GENERIC;
+    offset = request->createOffset;
+    packedStart = offset;
+    hr = DP_MSG_ReadPackedPlayer( (char *)body, &offset, bodySize, &info );
+    if ( FAILED( hr ) )
+        return hr;
+    if ( request->passwordOffset && request->passwordOffset < bodySize &&
+         (bodySize - request->passwordOffset) >= sizeof(WCHAR) &&
+         wmemchr( (const WCHAR *)((const char *)body + request->passwordOffset), 0,
+                  (bodySize - request->passwordOffset) / sizeof(WCHAR) ) )
+        password = (const WCHAR *)((const char *)body + request->passwordOffset);
+
+    EnterCriticalSection( &This->lock );
+    if ( !This->dp2->bConnectionOpen || !This->dp2->bHostInterface )
+    {
+        LeaveCriticalSection( &This->lock );
+        WARN( "join request, but this interface is not hosting\n" );
+        return DP_OK;
+    }
+    sd = This->dp2->lpSessionDesc;
+    TRACE( "join request from system player 0x%08lx (flags 0x%08lx, %lu bytes SP data)\n",
+           request->playerId, info.flags, info.spDataLength );
+
+    /* who may join */
+    if ( sd->dwFlags & (DPSESSION_JOINDISABLED | DPSESSION_NEWPLAYERSDISABLED) )
+    {
+        LeaveCriticalSection( &This->lock );
+        return nack( This, DPERR_CANTCREATEPLAYER, reply, replySize );
+    }
+    /* the session desc is stored WCHAR, as the password arrives */
+    if ( sd->lpszPassword && sd->lpszPassword[ 0 ] && (!password || lstrcmpW( sd->lpszPassword, password )) )
+    {
+        LeaveCriticalSection( &This->lock );
+        return nack( This, DPERR_INVALIDPASSWORD, reply, replySize );
+    }
+    if ( !(info.flags & DPLAYI_PLAYER_SYSPLAYER) || info.id != request->playerId )
+    {
+        LeaveCriticalSection( &This->lock );
+        return nack( This, DPERR_INVALIDPARAMS, reply, replySize );
+    }
+
+    /* the joining machine */
+    if ( DP_PlayerExists( This, request->playerId ) )
+    {
+        /* an id already in the session: only its own machine may ask again (a resent request). From
+         * anyone else it is an attempt to take an existing player over, so refuse it. */
+        BOOL known;
+        DPID sender = DP_SenderMachine( This, header, &known );
+        if ( known && sender != request->playerId )
+        {
+            LeaveCriticalSection( &This->lock );
+            WARN( "join for existing player 0x%08lx from machine 0x%08lx refused\n", request->playerId, sender );
+            return nack( This, DPERR_INVALIDPARAMS, reply, replySize );
+        }
+    }
+    else
+    {
+        DPID id = request->playerId;
+        /* a full session (dwMaxPlayers game players, 0 = no limit): the session search already hides it
+         * (name_server.c, okplay's sp.c); this is the backstop for a joiner that listed it before it
+         * filled. Refused like JOINDISABLED above: a NACK whose code the joiner's Open returns as is
+         * (every build of ours since 0.8.3, and Windows' joiner - Wine's dplayx test, check_Open).
+         * DPERR_CANTCREATEPLAYER is Windows': its dplayx hosting a game for 2 with 2 in refused a third
+         * joiner's Open with it (Windows 10, its TCP/IP provider, dptest --maxplayers/--joindelay,
+         * 2026-11-10). A resent request from a machine already in takes the branch above and is
+         * never refused here. */
+        if ( DP_SessionFull( This ) )
+        {
+            LeaveCriticalSection( &This->lock );
+            WARN( "join refused: the session is full (%lu of %lu players)\n", sd->dwCurrentPlayers, sd->dwMaxPlayers );
+            return nack( This, DPERR_CANTCREATEPLAYER, reply, replySize );
+        }
+        hr = DP_CreatePlayer( This, header, &id, &info.name, info.playerData, info.playerDataLength,
+                              info.spData, info.spDataLength, info.flags & ~DPLAYI_PLAYER_PLAYERLOCAL,
+                              NULL, NULL, FALSE );
+        if ( FAILED( hr ) )
+        {
+            LeaveCriticalSection( &This->lock );
+            return nack( This, hr, reply, replySize );
+        }
+        DP_SetPlayerSystemId( This, id, id );
+    }
+
+    /* every other machine learns about it */
+    for ( plist = DPQ_FIRST( This->dp2->lpSysGroup->players ); plist; plist = DPQ_NEXT( plist->players ) )
+    {
+        struct PlayerData *p = plist->lpPData;
+        if ( !(p->dwFlags & DPLAYI_PLAYER_SYSPLAYER) || (p->dwFlags & DPLAYI_PLAYER_PLAYERLOCAL) ||
+             p->dpid == request->playerId )
+            continue;
+        send_add_forward( This, p->dpid, request, (const char *)body + packedStart, offset - packedStart );
+    }
+
+    /* the reply: everything the joiner needs to build its copy of the session */
+    buf_add( &b, NULL, headerSize );
+    buf_add( &b, NULL, sizeof(*out) );
+    sdCopy = *sd;
+    sdCopy.lpszSessionName = NULL;
+    sdCopy.lpszPassword = NULL;
+    buf_add( &b, &sdCopy, sizeof(sdCopy) );
+    add_wstr( &b, sd->lpszSessionName ? sd->lpszSessionName : L"" );   /* byte for byte, as Windows */
+    {
+        DWORD packedOffset = b.size - headerSize;
+        struct PlayerData *order[ 256 ];
+        int count = 0, pass, k;
+
+        /* Windows' order (S3 tap, 2026-10-16): the system players newest first - the machine
+         * joining now leads - then the game players newest first (five players: 4 2 0 3 1) */
+        for ( plist = DPQ_FIRST( This->dp2->lpSysGroup->players ); plist && count < ARRAYSIZE( order );
+              plist = DPQ_NEXT( plist->players ) )
+            order[ count++ ] = plist->lpPData;
+        for ( pass = 0; pass < 2; pass++ )
+            for ( k = count - 1; k >= 0; k-- )
+            {
+                struct PlayerData *p = order[ k ];
+                /* every player is in the system group: Windows marks each record so (S3 tap: its
+                 * joiners create the host's system player with 0x7 and its game player with 0x4;
+                 * ours, without the bit, created them with 0x3 and 0x0) */
+                DWORD flags = p->dwFlags | DPLAYI_PLAYER_PLAYERINGROUP;
+                if ( !!(p->dwFlags & DPLAYI_PLAYER_SYSPLAYER) != !pass )
+                    continue;
+                if ( p->dpid == This->dp2->systemPlayerId )
+                    flags |= DPLAYI_PLAYER_NAMESRVR;
+                add_super_packed( This, &b, p->dpid, flags, p->name, p->lpRemoteData, p->dwRemoteDataSize,
+                                  p->systemPlayerId, NULL, 0, 0, FALSE );
+                players++;
+            }
+        for ( glist = DPQ_FIRST( This->dp2->lpSysGroup->groups ); glist; glist = DPQ_NEXT( glist->groups ) )
+        {
+            struct GroupData *g = glist->lpGData;
+            DPID ids[ 256 ];
+            DWORD n = 0;
+            for ( plist = DPQ_FIRST( g->players ); plist && n < ARRAYSIZE( ids ); plist = DPQ_NEXT( plist->players ) )
+                ids[ n++ ] = plist->lpPData->dpid;
+            add_super_packed( This, &b, g->dpid, g->dwFlags, g->name, g->lpRemoteData, g->dwRemoteDataSize,
+                              This->dp2->systemPlayerId, ids, n, g->parent, TRUE );
+            groups++;
+        }
+        if ( b.failed )
+        {
+            LeaveCriticalSection( &This->lock );
+            free( b.data );
+            return DPERR_OUTOFMEMORY;
+        }
+        out = (DPSP_MSG_SUPERENUMPLAYERSREPLY *)(b.data + headerSize);
+        out->envelope.dwMagic = DPMSGMAGIC_DPLAYMSG;
+        out->envelope.wCommandId = DPMSGCMD_SUPERENUMPLAYERSREPLY;
+        out->envelope.wVersion = HOST_WIRE_VERSION;
+        out->playerCount = players;
+        out->groupCount = groups;
+        out->packedOffset = packedOffset;
+        out->shortcutCount = 0;
+        out->descriptionOffset = sizeof(*out);
+        out->nameOffset = sizeof(*out) + sizeof(sdCopy);
+        out->passwordOffset = 0;
+    }
+    LeaveCriticalSection( &This->lock );
+
+    TRACE( "join of 0x%08lx accepted: %lu players, %lu groups, %lu bytes\n", request->playerId, players,
+           groups, b.size - headerSize );
+    *reply = b.data;
+    *replySize = b.size;
+    return DP_OK;
+}
diff -ruN src/dlls/dplayx/lifecycle.c port/dlls/dplayx/lifecycle.c
--- src/dlls/dplayx/lifecycle.c	1969-12-31 17:00:00.000000000 -0700
+++ port/dlls/dplayx/lifecycle.c	2026-10-28 19:22:33.674181400 -0700
@@ -0,0 +1,503 @@
+/*
+ * Session lifecycle: leaving, keepalive and host migration.
+ *
+ * Wine's dplayx never told anyone when a player or machine went away, never noticed a machine that
+ * vanished, and had no host migration ("FIXME: Need to find a new host I assume (how?)"). Here:
+ *
+ *  leaving    Close() sends DELETEPLAYER (11) for each local player and then the system player;
+ *             DestroyPlayer() sends it for that player. Receivers remove the player and queue
+ *             DPSYS_DESTROYPLAYERORGROUP for the application.
+ *  keepalive  with DPSESSION_KEEPALIVE, every machine pings every other machine's system player
+ *             (PING 22 / PINGREPLY 23) every 1.5 s; any message from a machine counts as a sign of
+ *             life. 15 s of silence and the machine is gone: its players are removed.
+ *  migration  when the host's machine goes and the session has DPSESSION_MIGRATEHOST, the
+ *             remaining machine with the lowest system player id becomes the host - every machine
+ *             computes the same answer from the same player list. The new host gets DPSYS_HOST,
+ *             announces itself (IAMNAMESERVER 53) and answers name-server requests from then on.
+ *             Without MIGRATEHOST the session is lost (DPSYS_SESSIONLOST).
+ *
+ * Part of the Windows port for Classic Netplay for AoE2. LGPL 2.1+, like the rest of dplayx.
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winerror.h"
+#include "wine/debug.h"
+
+#include "dplay_global.h"
+#include "dplayx_global.h"
+#include "dplayx_messages.h"
+
+#ifdef OKP_BUILTIN
+void okp_became_host( IDirectPlaySP *isp );   /* okplay/src/sp.c */
+int okp_drop_after_ms( void );                /* okplay.ini drop_after= (okplay/src/okp.h) */
+#define KEEPALIVE_DEAD_NOW() ((DWORD)okp_drop_after_ms())
+#else
+#define KEEPALIVE_DEAD_NOW() KEEPALIVE_DEAD_MS
+#endif
+
+WINE_DEFAULT_DEBUG_CHANNEL(dplay);
+
+#define KEEPALIVE_PING_MS  1500
+#define KEEPALIVE_DEAD_MS 15000   /* Windows notices in ~14.5 s */
+
+static struct PlayerData *find_player( IDirectPlayImpl *This, DPID id )
+{
+    struct PlayerList *plist;
+    if ( !This->dp2->lpSysGroup ) return NULL;
+    for ( plist = DPQ_FIRST( This->dp2->lpSysGroup->players ); plist; plist = DPQ_NEXT( plist->players ) )
+        if ( plist->lpPData->dpid == id ) return plist->lpPData;
+    return NULL;
+}
+
+static HRESULT send_system( IDirectPlayImpl *This, DPID to, void *msg, DWORD size, const void *extra,
+                            DWORD extraSize, DWORD flags )
+{
+    SGBUFFER buffers[ 3 ] = { 0 };
+    DPSP_SENDEXDATA data = { 0 };
+
+    buffers[ 0 ].len = This->dp2->spData.dwSPHeaderSize;
+    buffers[ 1 ].len = size;
+    buffers[ 1 ].pData = msg;
+    buffers[ 2 ].len = extraSize;
+    buffers[ 2 ].pData = (UCHAR *)extra;
+    data.lpISP = This->dp2->spData.lpISP;
+    data.dwFlags = flags;
+    data.idPlayerTo = to;
+    data.idPlayerFrom = This->dp2->systemPlayerId;
+    data.lpSendBuffers = buffers;
+    data.cBuffers = extraSize ? 3 : 2;
+    data.dwMessageSize = DP_MSG_ComputeMessageSize( buffers, data.cBuffers );
+    data.bSystemMessage = TRUE;
+    return DP_SP_SendEx( This, &data );
+}
+
+/* one message to every other machine */
+void DP_SendToAllMachines( IDirectPlayImpl *This, void *msg, DWORD size, const void *extra, DWORD extraSize )
+{
+    struct PlayerList *plist;
+    for ( plist = DPQ_FIRST( This->dp2->lpSysGroup->players ); plist; plist = DPQ_NEXT( plist->players ) )
+    {
+        struct PlayerData *p = plist->lpPData;
+        if ( (p->dwFlags & DPLAYI_PLAYER_SYSPLAYER) && !(p->dwFlags & DPLAYI_PLAYER_PLAYERLOCAL) )
+            send_system( This, p->dpid, msg, size, extra, extraSize, DPSEND_GUARANTEED );
+    }
+}
+
+HRESULT DP_MSG_SendDeletePlayer( IDirectPlayImpl *This, DPID playerId )
+{
+    DPSP_MSG_DELETEPLAYER msg = { 0 };
+
+    msg.envelope.dwMagic = DPMSGMAGIC_DPLAYMSG;
+    msg.envelope.wCommandId = DPMSGCMD_DELETEPLAYER;
+    msg.envelope.wVersion = DPMSGVER_DP6;
+    msg.playerId = playerId;
+    EnterCriticalSection( &This->lock );
+    if ( This->dp2->lpSysGroup ) DP_SendToAllMachines( This, &msg, sizeof(msg), NULL, 0 );
+    LeaveCriticalSection( &This->lock );
+    return DP_OK;
+}
+
+/* Close(): say goodbye for our players, then for this machine */
+void DP_LIFE_Leaving( IDirectPlayImpl *This )
+{
+    struct PlayerList *plist;
+    DPID ids[ 64 ];
+    int n = 0, i;
+
+    EnterCriticalSection( &This->lock );
+    if ( !This->dp2->bConnectionOpen || !This->dp2->lpSysGroup )
+    {
+        LeaveCriticalSection( &This->lock );
+        return;
+    }
+    for ( plist = DPQ_FIRST( This->dp2->lpSysGroup->players ); plist && n < ARRAYSIZE( ids ); plist = DPQ_NEXT( plist->players ) )
+    {
+        struct PlayerData *p = plist->lpPData;
+        if ( (p->dwFlags & DPLAYI_PLAYER_PLAYERLOCAL) && !(p->dwFlags & DPLAYI_PLAYER_SYSPLAYER) )
+            ids[ n++ ] = p->dpid;
+    }
+    for ( i = 0; i < n; i++ ) DP_MSG_SendDeletePlayer( This, ids[ i ] );
+    if ( This->dp2->systemPlayerId ) DP_MSG_SendDeletePlayer( This, This->dp2->systemPlayerId );
+    LeaveCriticalSection( &This->lock );
+    DP_NOTE( "leaving the session: told the other machines about %d player(s) and this machine\n", n );
+}
+
+/* any message from a machine proves it is alive */
+void DP_LIFE_Heard( IDirectPlayImpl *This, DPID anyPlayer )
+{
+    struct PlayerData *p;
+    EnterCriticalSection( &This->lock );
+    p = find_player( This, anyPlayer );
+    if ( p && !(p->dwFlags & DPLAYI_PLAYER_SYSPLAYER) && p->systemPlayerId ) p = find_player( This, p->systemPlayerId );
+    if ( p ) p->lastHeard = GetTickCount();
+    LeaveCriticalSection( &This->lock );
+}
+
+static void become_or_follow_new_host( IDirectPlayImpl *This, DPID newHost )
+{
+    struct PlayerList *plist;
+    struct PlayerData *p;
+    DPID highest = 0;
+
+    for ( plist = DPQ_FIRST( This->dp2->lpSysGroup->players ); plist; plist = DPQ_NEXT( plist->players ) )
+    {
+        p = plist->lpPData;
+        if ( p->dpid > highest ) highest = p->dpid;
+        if ( p->dwFlags & DPLAYI_PLAYER_SYSPLAYER )
+        {
+            if ( p->dpid == newHost ) p->dwFlags |= DPLAYI_PLAYER_NAMESRVR;
+            else p->dwFlags &= ~DPLAYI_PLAYER_NAMESRVR;
+        }
+    }
+    This->dp2->nameServerId = newHost;
+    This->dp2->hostMigrated = TRUE;
+
+    if ( newHost == This->dp2->systemPlayerId && !This->dp2->bHostInterface )
+    {
+        DPSP_MSG_IAMNAMESERVER msg = { 0 };
+        void *spData = NULL;
+        DWORD spDataSize = 0;
+
+        This->dp2->bHostInterface = TRUE;
+        DP_BumpObjectIds( highest );   /* ids we hand out must not collide with the old host's */
+        DP_QueueSystemMessage( This, DPSYS_HOST );
+        IDirectPlaySP_GetSPPlayerData( This->dp2->spData.lpISP, newHost, &spData, &spDataSize, DPSET_REMOTE );
+        msg.envelope.dwMagic = DPMSGMAGIC_DPLAYMSG;
+        msg.envelope.wCommandId = DPMSGCMD_IAMNAMESERVER;
+        msg.envelope.wVersion = DPMSGVER_DP6;
+        msg.hostId = newHost;
+        msg.flags = DPLAYI_PLAYER_SYSPLAYER | DPLAYI_PLAYER_NAMESRVR;
+        msg.spDataSize = spDataSize;
+        DP_SendToAllMachines( This, &msg, sizeof(msg), spData, spDataSize );
+        DP_NOTE( "host migration: this machine (0x%08lx) is the new host\n", newHost );
+#ifdef OKP_BUILTIN
+        /* Online/LAN Play: list the game under this machine now (no SP callback exists for this) */
+        okp_became_host( This->dp2->spData.lpISP );
+#endif
+    }
+    else
+        DP_NOTE( "host migration: machine 0x%08lx is the new host\n", newHost );
+}
+
+/* the host's machine left: pick the new host (or lose the session) */
+static void host_gone( IDirectPlayImpl *This )
+{
+    struct PlayerList *plist;
+    DPID newHost = 0;
+
+    if ( !(This->dp2->lpSessionDesc->dwFlags & DPSESSION_MIGRATEHOST) )
+    {
+        DP_NOTE( "the host left and the session does not migrate: session lost\n" );
+        DP_QueueSystemMessage( This, DPSYS_SESSIONLOST );
+        return;
+    }
+    for ( plist = DPQ_FIRST( This->dp2->lpSysGroup->players ); plist; plist = DPQ_NEXT( plist->players ) )
+    {
+        struct PlayerData *p = plist->lpPData;
+        if ( (p->dwFlags & DPLAYI_PLAYER_SYSPLAYER) && (!newHost || p->dpid < newHost) )
+            newHost = p->dpid;
+    }
+    if ( newHost )
+        become_or_follow_new_host( This, newHost );
+}
+
+/* a machine is gone (said goodbye, or went silent): its players leave with it */
+void DP_LIFE_MachineGone( IDirectPlayImpl *This, DPID systemPlayerId, const char *why )
+{
+    struct PlayerList *plist;
+    struct PlayerData *sys;
+    DPID ids[ 64 ];
+    int n = 0, i;
+    BOOL wasHost;
+
+    EnterCriticalSection( &This->lock );
+    sys = find_player( This, systemPlayerId );
+    if ( !This->dp2->bConnectionOpen || !sys || (sys->dwFlags & DPLAYI_PLAYER_PLAYERLOCAL) ||
+         !(sys->dwFlags & DPLAYI_PLAYER_SYSPLAYER) )
+    {
+        LeaveCriticalSection( &This->lock );
+        return;
+    }
+    wasHost = systemPlayerId == This->dp2->nameServerId || (sys->dwFlags & DPLAYI_PLAYER_NAMESRVR);
+    for ( plist = DPQ_FIRST( This->dp2->lpSysGroup->players ); plist && n < ARRAYSIZE( ids ); plist = DPQ_NEXT( plist->players ) )
+    {
+        struct PlayerData *p = plist->lpPData;
+        if ( p->dpid != systemPlayerId && p->systemPlayerId == systemPlayerId &&
+             !(p->dwFlags & DPLAYI_PLAYER_PLAYERLOCAL) )
+            ids[ n++ ] = p->dpid;
+    }
+    for ( i = 0; i < n; i++ ) DP_RemovePlayer( This, ids[ i ], FALSE );
+    DP_RemovePlayer( This, systemPlayerId, FALSE );
+    DP_NOTE( "machine 0x%08lx left (%s)%s: %d player(s) removed\n", systemPlayerId, why,
+             wasHost ? ", it was the host" : "", n );
+    if ( wasHost )
+        host_gone( This );
+    LeaveCriticalSection( &This->lock );
+}
+
+/* YOUAREDEAD (24): the host removed this machine (it went silent past the keepalive) and tells it so
+ * when it talks again. Windows' joiner then drops out of the session (okplay blackout, 2026-10-28):
+ * DPSYS_SESSIONLOST, then every other machine and its players leave (DPSYS_DESTROYPLAYERORGROUP for
+ * each player), no host migration, and it pings nobody after that. Its own players stay until Close. */
+HRESULT DP_LIFE_HandleYouAreDead( IDirectPlayImpl *This, const void *body, DWORD size, const void *header )
+{
+    struct PlayerList *plist;
+    DPID machines[ 64 ], ids[ 64 ], sender;
+    int nm = 0, n, i, j;
+    BOOL known;
+
+    EnterCriticalSection( &This->lock );
+    if ( !This->dp2->bConnectionOpen || !This->dp2->lpSysGroup || This->dp2->bHostInterface )
+    {
+        LeaveCriticalSection( &This->lock );
+        return DP_OK;
+    }
+    /* only the host decides who is in the session (no identity: a classic provider - trusted as before) */
+    sender = DP_SenderMachine( This, header, &known );
+    if ( known && sender != This->dp2->nameServerId )
+    {
+        DP_NOTE( "YOUAREDEAD from machine 0x%08lx ignored: not the host (0x%08lx)\n", sender, This->dp2->nameServerId );
+        LeaveCriticalSection( &This->lock );
+        return DP_OK;
+    }
+    DP_NOTE( "YOUAREDEAD from the host: this machine is out of the session\n" );
+    DP_QueueSystemMessage( This, DPSYS_SESSIONLOST );
+    for ( plist = DPQ_FIRST( This->dp2->lpSysGroup->players ); plist && nm < ARRAYSIZE( machines ); plist = DPQ_NEXT( plist->players ) )
+        if ( (plist->lpPData->dwFlags & DPLAYI_PLAYER_SYSPLAYER) && !(plist->lpPData->dwFlags & DPLAYI_PLAYER_PLAYERLOCAL) )
+            machines[ nm++ ] = plist->lpPData->dpid;
+    for ( j = 0; j < nm; j++ )
+    {
+        n = 0;
+        for ( plist = DPQ_FIRST( This->dp2->lpSysGroup->players ); plist && n < ARRAYSIZE( ids ); plist = DPQ_NEXT( plist->players ) )
+        {
+            struct PlayerData *p = plist->lpPData;
+            if ( p->dpid != machines[ j ] && p->systemPlayerId == machines[ j ] && !(p->dwFlags & DPLAYI_PLAYER_PLAYERLOCAL) )
+                ids[ n++ ] = p->dpid;
+        }
+        for ( i = 0; i < n; i++ ) DP_RemovePlayer( This, ids[ i ], FALSE );
+        DP_RemovePlayer( This, machines[ j ], FALSE );
+    }
+    LeaveCriticalSection( &This->lock );
+    return DP_OK;
+}
+
+HRESULT DP_LIFE_HandleDeletePlayer( IDirectPlayImpl *This, const void *body, DWORD size, const void *header )
+{
+    const DPSP_MSG_DELETEPLAYER *msg = body;
+    struct PlayerData *p;
+    BOOL machine;
+
+    if ( size < sizeof(*msg) ) return DPERR_GENERIC;
+    EnterCriticalSection( &This->lock );
+    p = find_player( This, msg->playerId );
+    /* a machine says goodbye for its own players only - nobody kicks another machine out */
+    if ( !This->dp2->bConnectionOpen || !p || (p->dwFlags & DPLAYI_PLAYER_PLAYERLOCAL) ||
+         !DP_SenderOwns( This, header, msg->playerId, "DELETEPLAYER" ) )
+    {
+        LeaveCriticalSection( &This->lock );
+        return DP_OK;
+    }
+    machine = (p->dwFlags & DPLAYI_PLAYER_SYSPLAYER) != 0;
+    if ( machine )
+        DP_LIFE_MachineGone( This, msg->playerId, "said goodbye" );
+    else
+    {
+        DP_RemovePlayer( This, msg->playerId, FALSE );
+        DP_NOTE( "player 0x%08lx left\n", msg->playerId );
+    }
+    LeaveCriticalSection( &This->lock );
+    return DP_OK;
+}
+
+HRESULT DP_LIFE_HandleIAmNameServer( IDirectPlayImpl *This, const void *body, DWORD size, const void *header )
+{
+    const DPSP_MSG_IAMNAMESERVER *msg = body;
+
+    if ( size < sizeof(*msg) ) return DPERR_GENERIC;
+    EnterCriticalSection( &This->lock );
+    if ( This->dp2->bConnectionOpen && find_player( This, msg->hostId ) &&
+         msg->hostId != This->dp2->nameServerId && msg->hostId != This->dp2->systemPlayerId )
+    {
+        /* a machine may announce only itself as the new host, and only once the host we know is
+         * actually gone - while it is still here nobody takes its place by saying so (our own keepalive
+         * elects a new host when the old one really leaves). Normally we elected the same machine already. */
+        if ( !DP_SenderOwns( This, header, msg->hostId, "IAMNAMESERVER" ) )
+            ;   /* refused and logged inside DP_SenderOwns */
+#ifndef DPLAYX_TEST_SKIP_AUTH
+        else if ( This->dp2->nameServerId && find_player( This, This->dp2->nameServerId ) )
+            DP_NOTE( "IAMNAMESERVER from 0x%08lx ignored: the host 0x%08lx is still here\n", msg->hostId,
+                     This->dp2->nameServerId );   /* a second guard, not a test control: dropped under SKIP_AUTH */
+#endif
+        else
+        {
+            This->dp2->bHostInterface = FALSE;
+            become_or_follow_new_host( This, msg->hostId );
+        }
+    }
+    LeaveCriticalSection( &This->lock );
+    return DP_OK;
+}
+
+/* TEST ONLY (OKP_TEST_ROGUE=deletehost|iamhost|sessiondesc): once, a few seconds into the session, this
+ * machine - a legitimate, already-joined member - sends a system message about a player it does not own,
+ * exactly as a griefer inside the game would. On a fixed build every other machine must refuse it
+ * (DP_SenderOwns) and the game go on under the real host; on a -DDPLAYX_TEST_SKIP_AUTH build the abuse
+ * takes effect, which is how run_local.sh `rogue` proves the check really fires. Never sends anything the
+ * game couldn't already send itself - it only puts another machine's id in the "whose" field. */
+static void rogue_fire( IDirectPlayImpl *This, const char *what )
+{
+    EnterCriticalSection( &This->lock );
+    if ( !This->dp2->bConnectionOpen || !This->dp2->lpSysGroup || !This->dp2->lpSessionDesc ||
+         This->dp2->bHostInterface )   /* only a non-host member plays the griefer */
+    {
+        LeaveCriticalSection( &This->lock );
+        return;
+    }
+    if ( !strcmp( what, "deletehost" ) )
+    {
+        DPSP_MSG_DELETEPLAYER msg = { 0 };
+        msg.envelope.dwMagic = DPMSGMAGIC_DPLAYMSG;
+        msg.envelope.wCommandId = DPMSGCMD_DELETEPLAYER;
+        msg.envelope.wVersion = DPMSGVER_DP6;
+        msg.playerId = This->dp2->nameServerId;   /* "the host has left" - a lie */
+        DP_SendToAllMachines( This, &msg, sizeof(msg), NULL, 0 );
+    }
+    else if ( !strcmp( what, "iamhost" ) )
+    {
+        DPSP_MSG_IAMNAMESERVER msg = { 0 };
+        msg.envelope.dwMagic = DPMSGMAGIC_DPLAYMSG;
+        msg.envelope.wCommandId = DPMSGCMD_IAMNAMESERVER;
+        msg.envelope.wVersion = DPMSGVER_DP6;
+        msg.hostId = This->dp2->systemPlayerId;    /* "I am the host now" - while the real one is here */
+        msg.flags = DPLAYI_PLAYER_SYSPLAYER | DPLAYI_PLAYER_NAMESRVR;
+        DP_SendToAllMachines( This, &msg, sizeof(msg), NULL, 0 );
+    }
+    else if ( !strcmp( what, "sessiondesc" ) )
+    {
+        static const WCHAR name[] = L"ROGUE";
+        DWORD size = sizeof(DPSP_MSG_SESSIONDESCCHANGED) + sizeof(name);
+        DPSP_MSG_SESSIONDESCCHANGED *m = calloc( 1, size );
+        if ( m )
+        {
+            m->envelope.dwMagic = DPMSGMAGIC_DPLAYMSG;
+            m->envelope.wCommandId = DPMSGCMD_SESSIONDESCCHANGED;
+            m->envelope.wVersion = DPMSGVER_DP6;
+            m->desc = *This->dp2->lpSessionDesc;
+            m->desc.lpszSessionName = NULL;
+            m->desc.lpszPassword = NULL;
+            m->desc.dwMaxPlayers = 1;              /* "the room is changed" - only the host may say so */
+            m->sessionNameOffset = sizeof(*m);
+            memcpy( m + 1, name, sizeof(name) );
+            DP_SendToAllMachines( This, m, size, NULL, 0 );
+            free( m );
+        }
+    }
+    DP_NOTE( "TEST ROGUE: this machine sent a forged %s to every other machine\n", what );
+    LeaveCriticalSection( &This->lock );
+}
+
+/* one round of the keepalive: pings to quiet machines, drops of silent ones (every 500 ms) */
+static void keepalive_once( IDirectPlayImpl *This )
+{
+        struct PlayerList *plist;
+        DPID dead[ 16 ];
+        int ndead = 0, i;
+        DWORD now = GetTickCount();
+
+        EnterCriticalSection( &This->lock );
+        if ( This->dp2->bConnectionOpen && This->dp2->lpSysGroup )
+        {
+            for ( plist = DPQ_FIRST( This->dp2->lpSysGroup->players ); plist; plist = DPQ_NEXT( plist->players ) )
+            {
+                struct PlayerData *p = plist->lpPData;
+                if ( !(p->dwFlags & DPLAYI_PLAYER_SYSPLAYER) || (p->dwFlags & DPLAYI_PLAYER_PLAYERLOCAL) )
+                    continue;
+                if ( !p->lastHeard ) p->lastHeard = now;
+                if ( now - p->lastHeard > KEEPALIVE_DEAD_NOW() )
+                {
+                    if ( ndead < ARRAYSIZE( dead ) ) dead[ ndead++ ] = p->dpid;
+                }
+                /* only a machine that has gone quiet: while it talks it is alive, and Windows sends
+                 * no PING then (S3 tap, 2026-10-16: none in a 14 s game with traffic, ours sent one
+                 * every 1.5 s regardless) */
+                else if ( now - p->lastHeard >= KEEPALIVE_PING_MS && now - p->lastPing >= KEEPALIVE_PING_MS )
+                {
+                    DPSP_MSG_PING ping;
+                    ping.envelope.dwMagic = DPMSGMAGIC_DPLAYMSG;
+                    ping.envelope.wCommandId = DPMSGCMD_PING;
+                    ping.envelope.wVersion = DPMSGVER_DP6;
+                    ping.fromId = This->dp2->systemPlayerId;
+                    ping.tickCount = now;
+                    send_system( This, p->dpid, &ping, sizeof(ping), NULL, 0, 0 );
+                    p->lastPing = now;
+                }
+            }
+        }
+        LeaveCriticalSection( &This->lock );
+        for ( i = 0; i < ndead; i++ )
+            DP_LIFE_MachineGone( This, dead[ i ], "no reply for drop_after= seconds" );
+}
+
+static DWORD WINAPI keepalive_thread( void *arg )
+{
+    IDirectPlayImpl *This = arg;
+    HANDLE stop = This->dp2->hKeepAliveStop;
+    const char *rogue = getenv( "OKP_TEST_ROGUE" );
+    DWORD started = GetTickCount();
+    BOOL rogue_done = FALSE;
+
+    while ( WaitForSingleObject( stop, 500 ) == WAIT_TIMEOUT )
+    {
+        if ( rogue && *rogue && !rogue_done && GetTickCount() - started > 4000 )
+        {
+            rogue_done = TRUE;
+            rogue_fire( This, rogue );
+        }
+        keepalive_once( This );
+    }
+    return 0;
+}
+
+#ifdef OKWEB_DPLAY
+/* the browser build has no threads: the same round runs as a task of the page's pump (okweb/dplay/winweb.c) */
+void winweb_every( DWORD ms, void (*fn)( void * ), void *arg );
+static void keepalive_task( void *arg ) { keepalive_once( arg ); }
+#endif
+
+/* the session is open (hosting or joined) */
+void DP_LIFE_Start( IDirectPlayImpl *This )
+{
+    if ( This->dp2->bHostInterface )
+        This->dp2->nameServerId = This->dp2->systemPlayerId;
+    if ( !(This->dp2->lpSessionDesc->dwFlags & DPSESSION_KEEPALIVE) || This->dp2->hKeepAliveThread )
+        return;
+#ifdef OKWEB_DPLAY
+    winweb_every( 500, keepalive_task, This );
+    This->dp2->hKeepAliveThread = (HANDLE)1;   /* "running" */
+    return;
+#endif
+    This->dp2->hKeepAliveStop = CreateEventW( NULL, TRUE, FALSE, NULL );
+    This->dp2->hKeepAliveThread = CreateThread( NULL, 0, keepalive_thread, This, 0, &This->dp2->dwKeepAliveThreadId );
+}
+
+void DP_LIFE_Stop( IDirectPlayImpl *This )
+{
+    if ( !This->dp2->hKeepAliveThread ) return;
+#ifdef OKWEB_DPLAY
+    winweb_every( 0, keepalive_task, This );
+    This->dp2->hKeepAliveThread = NULL;
+    return;
+#endif
+    SetEvent( This->dp2->hKeepAliveStop );
+    if ( GetCurrentThreadId() != This->dp2->dwKeepAliveThreadId )
+        WaitForSingleObject( This->dp2->hKeepAliveThread, 5000 );
+    CloseHandle( This->dp2->hKeepAliveThread );
+    CloseHandle( This->dp2->hKeepAliveStop );
+    This->dp2->hKeepAliveThread = NULL;
+    This->dp2->hKeepAliveStop = NULL;
+}
