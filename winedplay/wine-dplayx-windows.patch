-    hr = DP_MSG_SendAddPlayerToGroup( This, DPID_ALLPLAYERS, player, group );
-    if( FAILED( hr ) )
-    {
-        LeaveCriticalSection( &This->lock );
-        return hr;
-    }
-
-    LeaveCriticalSection( &This->lock );
-
-    return DP_OK;
-}
