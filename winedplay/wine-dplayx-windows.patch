-static DPNAME *DP_DuplicateName( const DPNAME *src, BOOL dstAnsi, BOOL srcAnsi )
-{
-    DPNAME *dst;
-    DWORD size;
-
-    size = DP_CopyName( NULL, src, dstAnsi, srcAnsi );
-
-    dst = malloc( size );
-    if ( !dst )
-        return NULL;
-
-    DP_CopyName( dst, src, dstAnsi, srcAnsi );
-
-    return dst;
-}
