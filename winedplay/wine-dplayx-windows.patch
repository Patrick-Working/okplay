+void DP_QueueSystemMessage( IDirectPlayImpl *This, DWORD type )
+{
+    DPMSG_GENERIC msg;
+    msg.dwType = type;
+    EnterCriticalSection( &This->lock );
+    DP_QueueMessage( This, DPID_SYSMSG, DPID_ALLPLAYERS, 0, &msg, DP_CopyGeneric, sizeof(msg) );
+    LeaveCriticalSection( &This->lock );
+}
