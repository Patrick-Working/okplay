-  }
-
-  TRACE( "Calling DPLSPInit (DPL SP entry point)\n" );
-
-  hr = (*DPLSPInit)( &This->dp2->dplspData );
-
-  if( FAILED(hr) )
-  {
-    ERR( "DPL SP Initialization failed: %s\n", DPLAYX_HresultToString(hr) );
-    FreeLibrary( hLobbyProvider );
-    return hr;
