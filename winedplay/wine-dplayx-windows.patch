+
+static HRESULT test_lobby_send( DWORD flags, const void *data, DWORD size )
+{
+  char hex[ 3 * 48 + 1 ];
+  DWORD i, n = size < 48 ? size : 48;
+
+  for( i = 0; i < n; i++ ) sprintf( hex + 3 * i, "%02x ", ((const BYTE *)data)[ i ] );
+  hex[ 3 * n ] = 0;
+  okp_log( 1, "test_lobby: the game sent its lobby a message: flags 0x%lx, %lu bytes: %s", flags, size, hex );
+  if( size >= sizeof(DPLMSG_GETPROPERTY) && ((const DPLMSG_GETPROPERTY *)data)->dwType == DPLSYS_GETPROPERTY )
+  {
+    const DPLMSG_GETPROPERTY *q = data;
+    DPLMSG_GETPROPERTYRESPONSE r;
+
+    memset( &r, 0, sizeof(r) );
+    r.dwType = DPLSYS_GETPROPERTYRESPONSE;
+    r.dwRequestID = q->dwRequestID;
+    r.guidPlayer = q->guidPlayer;
+    r.guidPropertyTag = q->guidPropertyTag;
+    if( IsEqualGUID( &q->guidPropertyTag, &DPLPROPERTY_MessagesSupported ) )
+    {
+      /* "no": this lobby sends no game settings, so the game goes on with its own */
+      r.hr = DP_OK;
+      r.dwDataSize = sizeof(DWORD);
+      r.dwPropertyData[ 0 ] = FALSE;
+    }
+    else
+      r.hr = DPERR_UNKNOWNMESSAGE;
+    okp_log( 1, "test_lobby: answered GETPROPERTY %s (request %lu): hr 0x%08lx", debugstr_guid( &q->guidPropertyTag ),
+             q->dwRequestID, r.hr );
+    test_lobby_queue( &r, sizeof(r), DPLMSG_STANDARD );
+  }
+  return DP_OK;
+}
+
+static HRESULT test_lobby_receive( DWORD *flags, void *data, DWORD *size )
+{
+  HRESULT hr = DPERR_NOMESSAGES;
+
+  if( !size ) return DPERR_INVALIDPARAMS;
+  test_lobby_enter();
+  if( test_lobby_qn )
+  {
+    if( !data || *size < test_lobby_q[ 0 ].size )
+    {
+      *size = test_lobby_q[ 0 ].size;
+      hr = DPERR_BUFFERTOOSMALL;
+    }
+    else
+    {
+      memcpy( data, test_lobby_q[ 0 ].data, test_lobby_q[ 0 ].size );
+      *size = test_lobby_q[ 0 ].size;
+      if( flags ) *flags = test_lobby_q[ 0 ].flags;
+      memmove( &test_lobby_q[ 0 ], &test_lobby_q[ 1 ], sizeof(test_lobby_q[ 0 ]) * (test_lobby_qn - 1) );
