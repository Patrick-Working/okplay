+/* The stored settings are always kept in their Unicode form: SetConnectionSettingsA converts on the way
+ * in, GetConnectionSettingsA on the way out (as Windows does). Stored as given, an ANSI game's settings
+ * (AoE2 sets them back after reading them) reached the Unicode readers - DPL_ConnectEx's join by name -
+ * as ANSI bytes read as WCHAR. A copy with the four strings converted; conn_free releases it. */
+static char *conv_to_a( const WCHAR *w )
+{
+  int n;
+  char *a;
+  if ( !w ) return NULL;
+  n = WideCharToMultiByte( CP_ACP, 0, w, -1, NULL, 0, NULL, NULL );
+  if ( (a = malloc( n ? n : 1 )) ) { a[ 0 ] = 0; WideCharToMultiByte( CP_ACP, 0, w, -1, a, n, NULL, NULL ); }
+  return a;
+}
+
+static WCHAR *conv_to_w( const char *a )
+{
+  int n;
+  WCHAR *w;
+  if ( !a ) return NULL;
+  n = MultiByteToWideChar( CP_ACP, 0, a, -1, NULL, 0 );
+  if ( (w = malloc( (n ? n : 1) * sizeof(WCHAR) )) ) { w[ 0 ] = 0; MultiByteToWideChar( CP_ACP, 0, a, -1, w, n ); }
+  return w;
+}
+
+static void conn_free( DPLCONNECTION *c )
+{
+  if ( !c ) return;
+  if ( c->lpSessionDesc )
+  {
+    free( c->lpSessionDesc->lpszSessionName );
+    free( c->lpSessionDesc->lpszPassword );
+    free( c->lpSessionDesc );
+  }
+  if ( c->lpPlayerName )
+  {
+    free( c->lpPlayerName->lpszShortName );
+    free( c->lpPlayerName->lpszLongName );
+    free( c->lpPlayerName );
+  }
+  free( c );
+}
+
+static DPLCONNECTION *conn_convert( const DPLCONNECTION *in, BOOL to_unicode )
+{
+  DPLCONNECTION *c;
+  if ( !in || !(c = calloc( 1, sizeof(*c) )) ) return NULL;
+  *c = *in;
+  c->lpSessionDesc = NULL;
+  c->lpPlayerName = NULL;
+  if ( in->lpSessionDesc && (c->lpSessionDesc = calloc( 1, sizeof(DPSESSIONDESC2) )) )
+  {
+    *c->lpSessionDesc = *in->lpSessionDesc;
+    if ( to_unicode )
+    {
+      c->lpSessionDesc->lpszSessionName = conv_to_w( in->lpSessionDesc->lpszSessionNameA );
+      c->lpSessionDesc->lpszPassword = conv_to_w( in->lpSessionDesc->lpszPasswordA );
+    }
+    else
+    {
+      c->lpSessionDesc->lpszSessionNameA = conv_to_a( in->lpSessionDesc->lpszSessionName );
+      c->lpSessionDesc->lpszPasswordA = conv_to_a( in->lpSessionDesc->lpszPassword );
+    }
+  }
+  if ( in->lpPlayerName && (c->lpPlayerName = calloc( 1, sizeof(DPNAME) )) )
+  {
+    *c->lpPlayerName = *in->lpPlayerName;
+    if ( to_unicode )
+    {
+      c->lpPlayerName->lpszShortName = conv_to_w( in->lpPlayerName->lpszShortNameA );
+      c->lpPlayerName->lpszLongName = conv_to_w( in->lpPlayerName->lpszLongNameA );
+    }
+    else
+    {
+      c->lpPlayerName->lpszShortNameA = conv_to_a( in->lpPlayerName->lpszShortName );
+      c->lpPlayerName->lpszLongNameA = conv_to_a( in->lpPlayerName->lpszLongName );
+    }
+  }
+  return c;
+}
