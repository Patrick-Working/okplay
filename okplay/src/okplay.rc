#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     OKP_VERSION_MAJOR, OKP_VERSION_MINOR, OKP_VERSION_PATCH, 0
PRODUCTVERSION  OKP_VERSION_MAJOR, OKP_VERSION_MINOR, OKP_VERSION_PATCH, 0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "oldkid.net"
            VALUE "FileDescription",  "Oldkid.net Online Play / LAN Play - DirectPlay service provider"
            VALUE "FileVersion",      OKP_VERSION_STR
            VALUE "InternalName",     "okplay"
            VALUE "OriginalFilename", "okplay.dll"
            VALUE "ProductName",      "Oldkid.net Play"
            VALUE "ProductVersion",   OKP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
