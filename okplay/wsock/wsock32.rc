#include <winver.h>
#include "version.h"

/* okplay wsock's version, as Explorer's Properties and Connection Check show it (src/version.h, OKP_WSOCK) */
VS_VERSION_INFO VERSIONINFO
FILEVERSION     OKP_VERSION_MAJOR, OKP_VERSION_MINOR, OKP_VERSION_PATCH, 0
PRODUCTVERSION  OKP_VERSION_MAJOR, OKP_VERSION_MINOR, OKP_VERSION_PATCH, 0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "oldkid.net"
            VALUE "FileDescription",  "Oldkid.net Online Play / LAN Play - for games that use Winsock"
            VALUE "FileVersion",      OKP_VERSION_STR
            VALUE "InternalName",     "okplay wsock"
            VALUE "OriginalFilename", "wsock32.dll"
            VALUE "ProductName",      "Oldkid.net Play"
            VALUE "ProductVersion",   OKP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
