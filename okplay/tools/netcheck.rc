/* Connection Check resources: the manifest (tools/netcheck.manifest) and the version */
#include <winuser.h>
1 RT_MANIFEST "netcheck.manifest"

/* the version resource (as src/okplay.rc): Connection Check ships with the drop-in and carries its
   version (src/version.h, the drop-in edition) */
#include <winver.h>
#define OKP_BUILTIN
#include "../src/version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     OKP_VERSION_MAJOR, OKP_VERSION_MINOR, OKP_VERSION_PATCH, 0
PRODUCTVERSION  OKP_VERSION_MAJOR, OKP_VERSION_MINOR, OKP_VERSION_PATCH, 0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "oldkid.net"
            VALUE "FileDescription",  "Oldkid.net Online Play - Connection Check"
            VALUE "FileVersion",      OKP_VERSION_STR
            VALUE "InternalName",     "netcheck"
            VALUE "OriginalFilename", "netcheck.exe"
            VALUE "ProductName",      "Oldkid.net Online Play"
            VALUE "ProductVersion",   OKP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
